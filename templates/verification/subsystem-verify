#!/usr/bin/env sh

set -eu

readonly EXIT_UNSUPPORTED=2
readonly EXIT_USAGE=64

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SUBSYSTEM_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
cd "$SUBSYSTEM_ROOT"

usage() {
    printf 'Usage: %s <fast|full>\n' "$0" >&2
}

run() {
    printf '+'
    printf ' %s' "$@"
    printf '\n'
    "$@"
}

unsupported() {
    printf 'Unsupported: %s\n' "$1" >&2
    return "$EXIT_UNSUPPORTED"
}

verify_fast() {
    # Replace this with low-cost, non-mutating project checks, for example:
    # run <test-command>
    unsupported 'fast verification is not configured for this subsystem'
}

verify_full() {
    # A configured full verifier normally runs fast first, then additional
    # isolated checks. Do not add setup, migration, import, release, or
    # production mutation commands here.
    verify_fast
    unsupported 'full verification is not configured for this subsystem'
}

if [ "$#" -ne 1 ]; then
    usage
    exit "$EXIT_USAGE"
fi

level=$1
printf '==> subsystem verification level=%s\n' "$level"

case "$level" in
    fast) verify_fast ;;
    full) verify_full ;;
    *)
        printf 'Unsupported verification level: %s\n' "$level" >&2
        usage
        exit "$EXIT_USAGE"
        ;;
esac
