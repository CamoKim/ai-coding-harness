#!/usr/bin/env sh

set -eu

readonly EXIT_FAILED=1
readonly EXIT_UNSUPPORTED=2
readonly EXIT_USAGE=64

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPOSITORY_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
cd "$REPOSITORY_ROOT"

usage() {
    printf 'Usage: %s <scope|all> <fast|full>\n' "$0" >&2
}

validate_name() {
    case "$1" in
        ''|*[!A-Za-z0-9._-]*)
            printf 'Invalid scope: %s\n' "$1" >&2
            exit "$EXIT_USAGE"
            ;;
    esac
}

resolve_verifier() {
    printf './%s/scripts/verify\n' "$1"
}

run_verifier() {
    scope=$1
    level=$2
    verifier=$(resolve_verifier "$scope")

    if [ ! -x "$verifier" ]; then
        printf 'Unsupported scope %s: executable verifier not found at %s\n' \
            "$scope" "$verifier" >&2
        return "$EXIT_UNSUPPORTED"
    fi

    printf '==> scope=%s level=%s verifier=%s\n' "$scope" "$level" "$verifier"
    "$verifier" "$level"
}

run_all() {
    level=$1
    found=0
    result=0

    for verifier in ./*/scripts/verify; do
        [ -e "$verifier" ] || continue
        [ -x "$verifier" ] || continue
        found=1
        scope=${verifier#./}
        scope=${scope%/scripts/verify}

        if run_verifier "$scope" "$level"; then
            :
        else
            status=$?
            if [ "$status" -eq "$EXIT_FAILED" ]; then
                result=$EXIT_FAILED
            elif [ "$result" -eq 0 ]; then
                result=$status
            fi
        fi
    done

    if [ "$found" -eq 0 ]; then
        printf 'No executable subsystem verifiers were found.\n' >&2
        return "$EXIT_UNSUPPORTED"
    fi

    return "$result"
}

if [ "$#" -ne 2 ]; then
    usage
    exit "$EXIT_USAGE"
fi

scope=$1
level=$2
validate_name "$scope"

case "$level" in
    fast|full) ;;
    *)
        printf 'Unsupported verification level: %s\n' "$level" >&2
        usage
        exit "$EXIT_USAGE"
        ;;
esac

if [ "$scope" = all ]; then
    run_all "$level"
else
    run_verifier "$scope" "$level"
fi
