#!/usr/bin/env python3
"""Record privacy-safe Codex turn telemetry from native hook events."""
from __future__ import annotations
import fcntl, hashlib, json, os, sys, time, uuid
from pathlib import Path
from typing import Any

MARKER = b"enabled\n"
def root() -> Path: return Path.home() / ".codex" / "harness" / "telemetry"
def valid() -> bool:
    marker = root() / "enabled"
    return marker.is_file() and not marker.is_symlink() and marker.read_bytes() == MARKER
def key(turn_id: str) -> Path: return root() / "turn-state" / hashlib.sha256(turn_id.encode()).hexdigest()
def text(event: dict[str, Any], field: str) -> str | None:
    value = event.get(field)
    return value if isinstance(value, str) else None

def start(event: dict[str, Any]) -> None:
    if not valid(): return
    turn_id = text(event, "turn_id")
    if turn_id is None: return
    directory = root() / "turn-state"; directory.mkdir(mode=0o700, exist_ok=True)
    path = key(turn_id)
    if path.exists(): return
    state = {"record_id": str(uuid.uuid4()), "started_monotonic_ns": time.monotonic_ns(), "approval_request_count": 0, "subagent_count": 0}
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError: return
    with os.fdopen(fd, "w", encoding="utf-8") as stream: json.dump(state, stream, separators=(",", ":"))

def increment(event: dict[str, Any], field: str) -> None:
    turn_id = text(event, "turn_id")
    if turn_id is None: return
    path = key(turn_id)
    if not path.is_file() or path.is_symlink(): return
    with path.open("r+", encoding="utf-8") as stream:
        fcntl.flock(stream.fileno(), fcntl.LOCK_EX); state = json.load(stream)
        state[field] = int(state.get(field, 0)) + 1
        stream.seek(0); stream.truncate(); json.dump(state, stream, separators=(",", ":")); stream.flush(); os.fsync(stream.fileno())

def append(record: dict[str, Any]) -> None:
    required = {"schema_version", "record_unit", "record_id", "model", "reasoning_effort", "duration_s", "approval_request_count", "subagent_count", "task_classification", "user_followup_count", "verification_retry_count", "runtime_e2e_retry_count", "verification_route", "runtime_e2e", "outcome"}
    if set(record) != required or record["schema_version"] != 2 or record["record_unit"] != "turn" or not isinstance(record["record_id"], str) or not isinstance(record["duration_s"], int) or not isinstance(record["approval_request_count"], int) or not isinstance(record["subagent_count"], int): return
    records = root() / "turns.jsonl"; fd = os.open(records, os.O_RDWR | os.O_CREAT | os.O_APPEND, 0o600)
    try:
        with os.fdopen(fd, "a+", encoding="utf-8") as stream:
            fcntl.flock(stream.fileno(), fcntl.LOCK_EX); stream.seek(0)
            if any(json.loads(line).get("record_id") == record["record_id"] for line in stream): return
            stream.write(json.dumps(record, separators=(",", ":")) + "\n"); stream.flush(); os.fsync(stream.fileno())
    finally:
        try: os.close(fd)
        except OSError: pass

def stop(event: dict[str, Any]) -> None:
    turn_id = text(event, "turn_id")
    if turn_id is None: return
    path = key(turn_id)
    if not path.is_file() or path.is_symlink(): return
    with path.open("r", encoding="utf-8") as stream:
        fcntl.flock(stream.fileno(), fcntl.LOCK_EX); state = json.load(stream)
        record = {"schema_version": 2, "record_unit": "turn", "record_id": state["record_id"], "model": text(event, "model"), "reasoning_effort": None, "duration_s": max(0, (time.monotonic_ns() - state["started_monotonic_ns"]) // 1_000_000_000), "approval_request_count": state["approval_request_count"], "subagent_count": state["subagent_count"], "task_classification": None, "user_followup_count": None, "verification_retry_count": None, "runtime_e2e_retry_count": None, "verification_route": None, "runtime_e2e": None, "outcome": None}
        append(record)
    path.unlink(missing_ok=True)

def main() -> int:
    try:
        event = json.load(sys.stdin)
        if not isinstance(event, dict): return 0
        name = event.get("hook_event_name")
        if name == "UserPromptSubmit": start(event)
        elif name == "PermissionRequest": increment(event, "approval_request_count")
        elif name == "SubagentStart": increment(event, "subagent_count")
        elif name == "Stop": stop(event)
    except Exception: pass
    return 0
if __name__ == "__main__": raise SystemExit(main())
