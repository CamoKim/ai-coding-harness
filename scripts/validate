#!/usr/bin/env sh

set -u

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
HARNESS_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
cd "$HARNESS_ROOT"
failures=0

fail() {
    printf 'FAIL: %s\n' "$1" >&2
    failures=$((failures + 1))
}

pass() {
    printf 'PASS: %s\n' "$1"
}

require_file() {
    path=$1
    if [ -f "$HARNESS_ROOT/$path" ]; then
        pass "required file: $path"
    else
        fail "missing required file: $path"
    fi
}

require_executable() {
    path=$1
    if [ -x "$HARNESS_ROOT/$path" ]; then
        pass "executable: $path"
    else
        fail "not executable: $path"
    fi
}

require_heading() {
    path=$1
    heading=$2
    if grep -F -x -q -- "$heading" "$HARNESS_ROOT/$path"; then
        pass "contract heading in $path: $heading"
    else
        fail "missing contract heading in $path: $heading"
    fi
}

require_text() {
    path=$1
    required_text=$2
    if grep -F -q -- "$required_text" "$HARNESS_ROOT/$path"; then
        pass "required text in $path: $required_text"
    else
        fail "missing required text in $path: $required_text"
    fi
}

required_files='
VERSION
CHANGELOG.md
README.md
docs/architecture.md
docs/adoption.md
docs/daily-usage.md
docs/configuration.md
docs/verification-contract.md
templates/global/AGENTS.md
templates/repository/AGENTS.md
templates/subsystem/AGENTS.md
scripts/validate
'

for path in $required_files; do
    require_file "$path"
done

shell_scripts='
scripts/validate
'

for path in $shell_scripts; do
    require_executable "$path"
    if sh -n "$HARNESS_ROOT/$path"; then
        pass "shell syntax: $path"
    else
        fail "invalid shell syntax: $path"
    fi
done

require_heading templates/repository/AGENTS.md '## Repository Map'
require_heading templates/repository/AGENTS.md '## Shared Dependencies'
require_heading templates/repository/AGENTS.md '## Subsystem Routing'
require_heading templates/repository/AGENTS.md '## Common Compatibility Contracts'
require_heading templates/repository/AGENTS.md '## Verification Entry Point'
require_heading templates/repository/AGENTS.md '## Verification Routing'
require_heading templates/repository/AGENTS.md '## Generated, Runtime, and Secret Data'
require_heading templates/repository/AGENTS.md '## Cross-subsystem Impact'
require_heading templates/subsystem/AGENTS.md '## Purpose and Scope'
require_heading templates/subsystem/AGENTS.md '## Execution Path'
require_heading templates/subsystem/AGENTS.md '## Architecture Constraints'
require_heading templates/subsystem/AGENTS.md '## Development Commands'
require_heading templates/subsystem/AGENTS.md '## Compatibility Contracts'
require_heading templates/subsystem/AGENTS.md '## Verification'
require_heading templates/subsystem/AGENTS.md '## Stateful or Destructive Operations'
require_heading templates/subsystem/AGENTS.md '## Sources of Truth and Generated Artifacts'
require_heading templates/subsystem/AGENTS.md '## Environment Limitations'
require_heading templates/global/AGENTS.md '## Efficiency and Escalation'
require_heading docs/architecture.md '## Ownership Boundary'
require_heading docs/architecture.md '## Optional OMX'
require_heading CHANGELOG.md '# Changelog'
require_heading docs/adoption.md '## Safe Manual Adoption'
require_heading docs/adoption.md '## Decide Where Information Belongs'
require_heading docs/adoption.md '## Define Project Verification'
require_heading docs/daily-usage.md '## Everyday Requests'
require_heading docs/daily-usage.md '## Native Codex Capabilities'
require_heading docs/daily-usage.md '## Optional OMX'
require_heading docs/architecture.md '## Instruction Hierarchy'
require_heading docs/configuration.md '## Local Configuration'
require_heading docs/verification-contract.md '## Change-aware Routing'
require_heading docs/verification-contract.md '## Exit Codes'
require_heading docs/verification-contract.md '## Mutation Boundary'
require_text README.md 'Native Codex owns its native capabilities'
require_text README.md 'Superpowers supplies generic engineering methodology'
require_text templates/global/AGENTS.md 'Correctness comes first'
require_text templates/global/AGENTS.md 'smallest workflow that can safely complete the task'
require_text templates/global/AGENTS.md 'Do not repeat a successful check unless'
require_text templates/global/AGENTS.md 'Do not repeatedly poll or wait for agents'
require_text templates/global/AGENTS.md 'Do not use token budgets, arbitrary limits'
require_text templates/global/AGENTS.md 'connected official app or connector'
require_text docs/adoption.md '~/.codex/AGENTS.md'
require_text docs/adoption.md './scripts/verify <scope> <level>'
require_text docs/daily-usage.md '/goal <outcome>'
require_text docs/daily-usage.md 'native subagents'
require_text docs/daily-usage.md 'Git worktrees'
require_text docs/daily-usage.md 'Codex review'
require_text docs/daily-usage.md 'codex exec'
require_text docs/daily-usage.md 'native hooks'
require_text docs/daily-usage.md './scripts/verify <scope> fast'
require_text docs/daily-usage.md 'Use OMX only when'

text_paths='
VERSION
README.md
docs
templates
scripts
'

absolute_path_pattern='/ho''me/[^/[:space:]]+|/Us''ers/[^/[:space:]]+|[A-Za-z]:\\Us''ers\\'
if grep -R -l -E -- "$absolute_path_pattern" $text_paths >/dev/null 2>&1; then
    grep -R -l -E -- "$absolute_path_pattern" $text_paths >&2
    fail 'local absolute path found in a managed text artifact'
else
    pass 'no local absolute paths in managed text artifacts'
fi

secret_pattern='s''k-[A-Za-z0-9_-]{16,}|gh''p_[A-Za-z0-9]{16,}|AK''IA[0-9A-Z]{16}|BEGIN [A-Z ]*PRIVATE K''EY'
if grep -R -l -E -- "$secret_pattern" $text_paths >/dev/null 2>&1; then
    grep -R -l -E -- "$secret_pattern" $text_paths >&2
    fail 'obvious secret pattern found in a managed text artifact'
else
    pass 'no obvious secret patterns in managed text artifacts'
fi

version_file=$HARNESS_ROOT/VERSION
version=$(sed -n '1p' "$version_file")
version_line_count=$(wc -l < "$version_file" | tr -d '[:space:]')
case "$version_line_count:$version" in
    1:*.*)
        case "$version" in
            *[!0-9.]*|.*|*..*|*.) fail 'VERSION must contain dot-separated numeric components on one line' ;;
            *) pass "version format: $version" ;;
        esac
        ;;
    *) fail 'VERSION must contain dot-separated numeric components on one line' ;;
esac

if grep -F -x -q -- "## $version" "$HARNESS_ROOT/CHANGELOG.md"; then
    pass "current version has changelog entry: $version"
else
    fail "missing changelog entry for current version: $version"
fi

if [ "$failures" -ne 0 ]; then
    printf '\nHarness validation failed with %s issue(s).\n' "$failures" >&2
    exit 1
fi

printf '\nHarness validation passed.\n'
