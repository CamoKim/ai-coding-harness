#!/usr/bin/env sh

set -u

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
HARNESS_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
cd "$HARNESS_ROOT"
failures=0

fail() {
    printf 'FAIL: %s\n' "$1" >&2
    failures=$((failures + 1))
}

pass() {
    printf 'PASS: %s\n' "$1"
}

require_file() {
    path=$1
    if [ -f "$HARNESS_ROOT/$path" ]; then
        pass "required file: $path"
    else
        fail "missing required file: $path"
    fi
}

require_executable() {
    path=$1
    if [ -x "$HARNESS_ROOT/$path" ]; then
        pass "executable: $path"
    else
        fail "not executable: $path"
    fi
}

require_heading() {
    path=$1
    heading=$2
    if grep -F -x -q -- "$heading" "$HARNESS_ROOT/$path"; then
        pass "contract heading in $path: $heading"
    else
        fail "missing contract heading in $path: $heading"
    fi
}

required_files='
VERSION
CHANGELOG.md
README.md
docs/architecture.md
docs/behavioral-lab-contract.md
docs/configuration.md
docs/doctor-contract.md
docs/install-contract.md
docs/uninstall-contract.md
docs/execution-policy.md
docs/telemetry-contract.md
docs/verification-contract.md
templates/global/AGENTS.md
templates/repository/AGENTS.md
templates/subsystem/AGENTS.md
templates/verification/repository-verify
templates/verification/subsystem-verify
scripts/telemetry-record
scripts/install-telemetry-hooks
scripts/harness-install
scripts/harness-uninstall
scripts/behavioral-lab
scripts/doctor
scripts/validate
tests/test_telemetry_record.py
tests/test_doctor.py
tests/test_harness_install.py
tests/test_harness_uninstall.py
tests/test_behavioral_lab.py
'

for path in $required_files; do
    require_file "$path"
done

shell_scripts='
templates/verification/repository-verify
templates/verification/subsystem-verify
scripts/validate
scripts/install-telemetry-hooks
scripts/doctor
'

for path in $shell_scripts; do
    require_executable "$path"
    if sh -n "$HARNESS_ROOT/$path"; then
        pass "shell syntax: $path"
    else
        fail "invalid shell syntax: $path"
    fi
done

require_executable scripts/telemetry-record
require_executable scripts/install-telemetry-hooks
require_executable scripts/harness-install
require_executable scripts/harness-uninstall
require_executable scripts/behavioral-lab
require_executable scripts/doctor
if python3 -c 'import ast, pathlib, sys; ast.parse(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))' "$HARNESS_ROOT/scripts/harness-install"; then
    pass 'Python syntax: scripts/harness-install'
else
    fail 'invalid Python syntax: scripts/harness-install'
fi
if python3 -c 'import ast, pathlib, sys; ast.parse(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))' "$HARNESS_ROOT/scripts/harness-uninstall"; then
    pass 'Python syntax: scripts/harness-uninstall'
else
    fail 'invalid Python syntax: scripts/harness-uninstall'
fi
if python3 -c 'import ast, pathlib, sys; ast.parse(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))' "$HARNESS_ROOT/scripts/behavioral-lab"; then
    pass 'Python syntax: scripts/behavioral-lab'
else
    fail 'invalid Python syntax: scripts/behavioral-lab'
fi
if PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -p 'test_*.py'; then
    pass 'telemetry helper tests'
else
    fail 'telemetry helper tests failed'
fi

require_heading templates/repository/AGENTS.md '## Repository Map'
require_heading templates/repository/AGENTS.md '## Shared Dependencies'
require_heading templates/repository/AGENTS.md '## Subsystem Routing'
require_heading templates/repository/AGENTS.md '## Common Compatibility Contracts'
require_heading templates/repository/AGENTS.md '## Verification Entry Point'
require_heading templates/repository/AGENTS.md '## Verification Routing'
require_heading templates/repository/AGENTS.md '## Generated, Runtime, and Secret Data'
require_heading templates/repository/AGENTS.md '## Cross-subsystem Impact'
require_heading templates/subsystem/AGENTS.md '## Purpose and Scope'
require_heading templates/subsystem/AGENTS.md '## Execution Path'
require_heading templates/subsystem/AGENTS.md '## Architecture Constraints'
require_heading templates/subsystem/AGENTS.md '## Development Commands'
require_heading templates/subsystem/AGENTS.md '## Compatibility Contracts'
require_heading templates/subsystem/AGENTS.md '## Verification'
require_heading templates/subsystem/AGENTS.md '## Stateful or Destructive Operations'
require_heading templates/subsystem/AGENTS.md '## Sources of Truth and Generated Artifacts'
require_heading templates/subsystem/AGENTS.md '## Environment Limitations'
require_heading docs/architecture.md '## Ownership Boundary'
require_heading docs/behavioral-lab-contract.md '# Behavioral Lab Contract'
require_heading CHANGELOG.md '# Changelog'
require_heading docs/architecture.md '## Instruction Hierarchy'
require_heading docs/configuration.md '## Portable Configuration'
require_heading docs/configuration.md '## Local Configuration'
require_heading docs/doctor-contract.md '# Harness Doctor Contract'
require_heading docs/install-contract.md '# Harness Install Contract'
require_heading docs/uninstall-contract.md '# Harness Uninstall Contract'
require_heading docs/execution-policy.md '## Task Levels'
require_heading docs/execution-policy.md '## Autonomy Rules'
require_heading docs/execution-policy.md '## Project Overrides'
require_heading docs/execution-policy.md '## Optional Methodology Providers'
require_heading docs/telemetry-contract.md '## Opt-in and Storage'
require_heading docs/telemetry-contract.md '## Schema'
require_heading docs/telemetry-contract.md '## Data Minimization'
require_heading docs/telemetry-contract.md '## Runtime Helper Installation'
require_heading docs/telemetry-contract.md '## Helper Boundary'
if ! command -v grep >/dev/null 2>&1; then
    fail 'grep is required for legacy telemetry path validation'
else
    legacy_record_path='tasks.''jsonl'
    legacy_matches=$(find docs scripts templates -type f -exec grep -F -l "$legacy_record_path" {} \; 2>&1)
    scan_status=$?
    if [ "$scan_status" -ne 0 ]; then
        printf '%s\n' "$legacy_matches" >&2
        fail 'legacy telemetry path validation scan failed'
    elif [ -n "$legacy_matches" ]; then
        printf '%s\n' "$legacy_matches" >&2
        fail 'legacy telemetry task record path found'
    else
        pass 'turn telemetry record path is canonical'
    fi
fi
require_heading docs/verification-contract.md '## Change-aware Routing'
require_heading docs/verification-contract.md '## Exit Codes'
require_heading docs/verification-contract.md '## Mutation Boundary'

text_paths='
VERSION
README.md
docs
templates
scripts
'

absolute_path_pattern='/ho''me/[^/[:space:]]+|/Us''ers/[^/[:space:]]+|[A-Za-z]:\\Us''ers\\'
if grep -R -l -E -- "$absolute_path_pattern" $text_paths >/dev/null 2>&1; then
    grep -R -l -E -- "$absolute_path_pattern" $text_paths >&2
    fail 'local absolute path found in a managed text artifact'
else
    pass 'no local absolute paths in managed text artifacts'
fi

secret_pattern='s''k-[A-Za-z0-9_-]{16,}|gh''p_[A-Za-z0-9]{16,}|AK''IA[0-9A-Z]{16}|BEGIN [A-Z ]*PRIVATE K''EY'
if grep -R -l -E -- "$secret_pattern" $text_paths >/dev/null 2>&1; then
    grep -R -l -E -- "$secret_pattern" $text_paths >&2
    fail 'obvious secret pattern found in a managed text artifact'
else
    pass 'no obvious secret patterns in managed text artifacts'
fi

version_file=$HARNESS_ROOT/VERSION
version=$(sed -n '1p' "$version_file")
version_line_count=$(wc -l < "$version_file" | tr -d '[:space:]')
case "$version_line_count:$version" in
    1:*.*)
        case "$version" in
            *[!0-9.]*|.*|*..*|*.) fail 'VERSION must contain dot-separated numeric components on one line' ;;
            *) pass "version format: $version" ;;
        esac
        ;;
    *) fail 'VERSION must contain dot-separated numeric components on one line' ;;
esac

if [ "$failures" -ne 0 ]; then
    printf '\nHarness validation failed with %s issue(s).\n' "$failures" >&2
    exit 1
fi

printf '\nHarness validation passed.\n'
