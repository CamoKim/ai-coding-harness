#!/usr/bin/env python3
"""Safely adopt and update the small set of user-level Harness artifacts."""
import hashlib
import json
import os
import shutil
import stat
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
MANIFEST_NAME = "managed-artifacts.json"


@dataclass(frozen=True)
class Artifact:
    name: str
    source: Path
    target: Path
    mode: int


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def fingerprint(path):
    if path.is_symlink() or not path.is_file():
        return None
    return {"sha256": digest(path), "mode": stat.S_IMODE(path.stat().st_mode)}


def artifacts(home):
    codex = home / ".codex"
    return (
        Artifact("global-agents", ROOT / "templates/global/AGENTS.md", codex / "AGENTS.md", 0o644),
        Artifact("telemetry-handler", ROOT / "scripts/telemetry-record", codex / "harness/bin/telemetry-record", 0o700),
        Artifact("hooks-json", ROOT / "templates/telemetry/hooks.json", codex / "hooks.json", 0o644),
    )


def source_fingerprint(artifact):
    if artifact.source.is_symlink() or not artifact.source.is_file():
        raise ValueError("source unavailable")
    return {"sha256": digest(artifact.source), "mode": artifact.mode}


def load_manifest(path):
    if not path.exists():
        return None
    if path.is_symlink() or not path.is_file():
        raise ValueError("manifest is not a regular file")
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise ValueError("manifest is invalid") from exc
    if value.get("schema_version") != 1 or not isinstance(value.get("artifacts"), dict):
        raise ValueError("manifest schema is invalid")
    return value


def inline_hooks_conflict(config):
    if not config.exists():
        return False
    if config.is_symlink() or not config.is_file():
        raise ValueError("config.toml is not a regular file")
    for line in config.read_text(encoding="utf-8").splitlines():
        stripped = line.strip()
        if stripped == "[hooks]" or stripped == "[[hooks]]" or stripped.startswith("[hooks] #") or stripped.startswith("[[hooks]] #"):
            return True
    return False


def evaluate(items, manifest, config):
    config_conflict = inline_hooks_conflict(config)
    records = {} if manifest is None else manifest["artifacts"]
    result = []
    for item in items:
        try:
            desired = source_fingerprint(item)
        except ValueError as exc:
            result.append((item, "ERROR", str(exc), None))
            continue
        if item.target.is_symlink() or (item.target.exists() and not item.target.is_file()):
            result.append((item, "CONFLICT", "target is not a regular file", desired))
            continue
        if item.name == "hooks-json" and config_conflict:
            result.append((item, "CONFLICT", "inline hooks configuration requires manual review", desired))
            continue
        current = fingerprint(item.target) if item.target.exists() else None
        previous = records.get(item.name)
        if previous is not None and (not isinstance(previous, dict) or set(previous) != {"sha256", "mode"}):
            result.append((item, "ERROR", "manifest artifact fingerprint is invalid", desired))
        elif current is None:
            status = "UNMANAGED_DRIFT" if previous is not None else "MISSING"
            detail = "managed target missing" if previous is not None else "target missing"
            result.append((item, status, detail, desired))
        elif current == desired:
            status = "EXACT" if previous == desired else "ADOPTABLE"
            detail = "managed parity" if status == "EXACT" else "target parity; provenance absent or stale"
            result.append((item, status, detail, desired))
        elif previous is not None and current == previous:
            result.append((item, "SAFE_UPGRADE", "managed baseline matches target", desired))
        else:
            result.append((item, "UNMANAGED_DRIFT", "target differs from source or managed baseline", desired))
    return result


def report(items, extra=None):
    for item, status, detail, _ in items:
        print(f"{item.name}\t{status}\t{detail}")
    if extra:
        print(extra)
    print("hooks-trust\tNOT_MANAGED\tCodex trust and config.toml are never modified")


def result_code(items):
    states = {state for _, state, _, _ in items}
    if "ERROR" in states:
        return 2
    if states & {"CONFLICT", "UNMANAGED_DRIFT"}:
        return 3
    if states & {"MISSING", "ADOPTABLE", "SAFE_UPGRADE"}:
        return 1
    return 0


def write_stage(path, content, mode):
    path.write_bytes(content)
    os.chmod(path, mode)


def apply(items, manifest, manifest_path, config, replace=os.replace):
    manifest_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    work = Path(tempfile.mkdtemp(prefix=".harness-install-", dir=manifest_path.parent))
    changed = []
    backups = {}
    try:
        # Recheck after staging begins so a user edit cannot turn a reviewed plan
        # into a replacement of unknown content.
        items = evaluate([item for item, _, _, _ in items], manifest, config)
        if result_code(items) in (2, 3):
            raise RuntimeError("artifact changed during apply")
        needed = [entry for entry in items if entry[1] in {"MISSING", "SAFE_UPGRADE"}]
        for item, _, _, _ in needed:
            write_stage(work / item.name, item.source.read_bytes(), item.mode)
        records = {item.name: desired for item, _, _, desired in items}
        staged_manifest = work / MANIFEST_NAME
        write_stage(staged_manifest, (json.dumps({"schema_version": 1, "artifacts": records}, sort_keys=True) + "\n").encode(), 0o600)
        previous_records = {} if manifest is None else manifest["artifacts"]
        for item, state, _, desired in needed:
            current = fingerprint(item.target) if item.target.exists() else None
            # Check the expected preflight baseline immediately before replacement.
            if state == "MISSING" and current is not None:
                raise RuntimeError(f"{item.name} changed during apply")
            if state == "SAFE_UPGRADE" and current != previous_records[item.name]:
                raise RuntimeError(f"{item.name} changed during apply")
            if current is not None:
                backup = work / f"backup-{item.name}"
                shutil.copyfile(item.target, backup)
                os.chmod(backup, current["mode"])
                backups[item.name] = backup
            item.target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
            replace(work / item.name, item.target)
            changed.append(item)
        for item, _, _, desired in items:
            if fingerprint(item.target) != desired:
                raise RuntimeError(f"{item.name} parity check failed")
        replace(staged_manifest, manifest_path)
        os.chmod(manifest_path, 0o600)
        return True, "all artifacts applied and manifest updated"
    except Exception as exc:
        rollback_ok = True
        for item in reversed(changed):
            try:
                if item.name in backups:
                    replace(backups[item.name], item.target)
                elif item.target.exists() and not item.target.is_symlink():
                    item.target.unlink()
                else:
                    rollback_ok = False
            except OSError:
                rollback_ok = False
        detail = f"apply failed: {exc}"
        if not rollback_ok:
            detail += "; recovery-required: rollback failed"
        return False, detail
    finally:
        shutil.rmtree(work, ignore_errors=True)


def main(argv):
    if argv not in (["--check"], ["--apply"]):
        print(f"usage: {Path(sys.argv[0]).name} --check|--apply", file=sys.stderr)
        return 64
    home = Path.home()
    manifest_path = home / ".codex/harness" / MANIFEST_NAME
    try:
        manifest = load_manifest(manifest_path)
        items = evaluate(artifacts(home), manifest, home / ".codex/config.toml")
    except (OSError, ValueError) as exc:
        print(f"install\tERROR\t{exc}")
        print("SUMMARY\tERROR\tpreflight could not complete")
        return 2
    code = result_code(items)
    report(items)
    if argv == ["--check"]:
        summary = "exact managed parity" if code == 0 else "apply eligible" if code == 1 else "blocked by drift or conflict" if code == 3 else "preflight error"
        print(f"SUMMARY\t{'OK' if code == 0 else 'ACTION_REQUIRED' if code == 1 else 'BLOCKED'}\t{summary}")
        return code
    if code in (2, 3):
        print("SUMMARY\tBLOCKED\tno artifact or manifest was changed")
        return code
    ok, detail = apply(items, manifest, manifest_path, home / ".codex/config.toml")
    if not ok:
        print(f"SUMMARY\tERROR\t{detail}")
        return 2
    try:
        final = evaluate(artifacts(home), load_manifest(manifest_path), home / ".codex/config.toml")
    except (OSError, ValueError) as exc:
        print(f"SUMMARY\tERROR\tapply completed but final check failed: {exc}")
        return 2
    if result_code(final) != 0:
        report(final)
        print("SUMMARY\tERROR\tapply completed without exact managed parity")
        return 2
    print(f"SUMMARY\tOK\t{detail}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
